NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gates the dev-login role selector and dev-login impersonation fixtures.
# Auto-on when NODE_ENV !== 'production' (local/dev). Defaults OFF in production:
# the /dev-login and /api/dev-login/* routes are unreachable and the login wall
# only accepts real Supabase sessions. Set to 'true' ONLY as a staging
# break-glass to re-enable dev-login on a non-local deploy. Impersonation in
# production still requires a real authenticated super_admin/platform_admin.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=

# Weather provider configuration
# Supported values: openweather, national_weather_service
# If omitted, GameDay OS uses OpenWeather unless a weather profile source is National Weather Service.
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=
# Optional fallback name supported by the code for existing deployments.
WEATHER_API_KEY=

# Optional no-auth admin testing bridge for permission-checked admin APIs.
# Set to a users.id value that has scoped automation permissions.
NEXT_PUBLIC_GAMEDAY_ADMIN_ACTOR_USER_ID=

# Integration Framework - SportsEngine OAuth2
SPORTSENGINE_CLIENT_ID=
SPORTSENGINE_CLIENT_SECRET=
SPORTSENGINE_REDIRECT_URI=
SPORTSENGINE_GRAPHQL_URL=

# Integration Framework - future providers
STRIPE_SECRET_KEY=

# Daktronics read-only local adapter ingestion
# Server-only token used by POST /api/integrations/daktronics/readings.
DAKTRONICS_ADAPTER_TOKEN=
