NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gates the dev-login role selector and dev-login impersonation fixtures.
# Auto-on when NODE_ENV !== 'production' (local/dev). Defaults OFF in production:
# the /dev-login and /api/dev-login/* routes are unreachable and the login wall
# only accepts real Supabase sessions. Set to 'true' ONLY as a staging
# break-glass to re-enable dev-login on a non-local deploy. Impersonation in
# production still requires a real authenticated super_admin/platform_admin.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=
